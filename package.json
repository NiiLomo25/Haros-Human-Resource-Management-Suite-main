{
  "name": "haros-hrmis",
  "private": true,
  "version": "2.5.0",
  "description": "Haros Human Resource Management Suite - standalone offline Windows HRMIS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist:x64": "vite build && electron-builder --win nsis --x64 --publish never",
    "dist:x86": "vite build && electron-builder --win nsis --ia32 --publish never",
    "dist:win": "npm run dist:x64 && npm run dist:x86",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.13.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.19",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.5",
    "@typescript/typescript-win32-x64": "^7.0.2",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
